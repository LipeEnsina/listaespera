# ============================================================
#  Copie para .env.local e preencha. NUNCA versione o .env.local.
# ============================================================

# ---- Supabase ----------------------------------------------
# Supabase → Project Settings → Data API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Supabase → Project Settings → API Keys → service_role (secret)
# ATENÇÃO: essa chave ignora o RLS. Ela só é usada no servidor.
# Nunca coloque o prefixo NEXT_PUBLIC_ nela.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Painel administrativo ---------------------------------
ADMIN_USERNAME=lipe
ADMIN_PASSWORD=

# Assina o cookie de sessão. Gere um valor único com:
#   openssl rand -base64 32
ADMIN_SESSION_SECRET=

# ---- Site --------------------------------------------------
# Domínio final, usado nas metatags de compartilhamento.
NEXT_PUBLIC_SITE_URL=https://lipeensina.com.br
