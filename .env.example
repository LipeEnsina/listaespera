# ============================================================
#  Copie para .env.local e preencha. NUNCA versione o .env.local.
#
#  Nenhuma destas variaveis e lida pelo navegador — todas rodam so no
#  servidor. Por isso nenhuma leva o prefixo NEXT_PUBLIC_.
# ============================================================

# ---- Supabase ----------------------------------------------
# Supabase -> Project Settings -> Data API -> Project URL
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Supabase -> Project Settings -> API Keys -> service_role (secret)
# ATENCAO: essa chave ignora o RLS. Ela so e usada no servidor.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Painel administrativo ---------------------------------
ADMIN_USERNAME=lipe
ADMIN_PASSWORD=

# Assina o cookie de sessao. Gere um valor unico com:
#   openssl rand -base64 32
ADMIN_SESSION_SECRET=

# ---- Site (opcional) ---------------------------------------
# So preenche as metatags de compartilhamento (o cartao que aparece
# ao colar o link no WhatsApp/Instagram). Pode deixar de fora ate o
# dominio existir — o codigo usa um padrao sozinho.
# SITE_URL=https://lipeensina.com.br
